{
  "name": "@safronmandev1/ui-kit",
  "version": "0.1.1",
  "description": "Reusable React UI components.",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/lib/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/styles.css",
    "dist/types",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/safronman/ui-kit-18-08.git"
  },
  "bugs": {
    "url": "https://github.com/safronman/ui-kit-18-08/issues"
  },
  "homepage": "https://github.com/safronman/ui-kit-18-08#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && pnpm run build:lib && pnpm run build:types",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:types": "tsc -p tsconfig.lib.json",
    "lint": "oxlint",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest --project storybook run",
    "prepublishOnly": "pnpm run lint && pnpm run build && pnpm run test:storybook"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@chromatic-com/storybook": "latest",
    "@rolldown/plugin-babel": "^0.2.3",
    "@storybook/addon-a11y": "^10.5.9",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/addon-mcp": "latest",
    "@storybook/addon-vitest": "^10.5.9",
    "@storybook/react-vite": "^10.5.9",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "babel-plugin-react-compiler": "^1.0.0",
    "mockdate": "^3.0.5",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "oxlint": "^1.75.0",
    "playwright": "latest",
    "storybook": "^10.5.9",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "latest"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "imports": {
    "#*": [
      "./*",
      "./*.ts",
      "./*.tsx",
      "./*.js",
      "./*.jsx"
    ]
  }
}
